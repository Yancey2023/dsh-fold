{
  "name": "dsh-tool-group",
  "version": "0.1.0",
  "description": "DSH Web UI plugin: fold consecutive tool calls in one assistant turn into a single line (Codex-style), with live running-tool label, call count, and expand/collapse. Pure Slot/React implementation, no DOM patching.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/group.test.mjs && node test/overlay.test.mjs && node test/bundle-smoke.mjs && node test/component.test.mjs && node test/integration.test.mjs",
    "install:dsh": "node scripts/install-dsh.cjs",
    "uninstall:dsh": "node scripts/install-dsh.cjs uninstall"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.2",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-test-renderer": "~18.3.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "react": "^18.3.1"
  },
  "license": "MIT"
}
